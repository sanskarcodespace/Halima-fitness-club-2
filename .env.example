# Halima Fitness Club — Environment Variables
# Copy this file to .env and fill in the values.

# ─── Instagram Live Feed ─────────────────────────────────────────────────────
# Required to enable the live Instagram feed on the website.
# How to get your token:
#   1. Go to https://developers.facebook.com/apps/ and create an App
#   2. Add the "Instagram Basic Display" product
#   3. Add @sadiya_fitcoach as a Test User
#   4. Generate a User Token → Exchange for a Long-Lived Token (60-day expiry)
#   5. Paste the token below
#
# If this is empty or missing, the website shows a "Connect Feed" setup card.
VITE_INSTAGRAM_ACCESS_TOKEN=

# ─── WhatsApp ────────────────────────────────────────────────────────────────
# Add your full international WhatsApp number (no spaces, no +).
# Example: 919876543210 for +91 98765 43210
# VITE_WHATSAPP_NUMBER=
